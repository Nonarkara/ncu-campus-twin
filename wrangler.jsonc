{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncu-campus-twin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node pipeline/build-info.mjs" },
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "routes": [{ "pattern": "ncu.nonarkara.org", "custom_domain": true }],
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "LIVE", "id": "2ce57fb11c484cc0b302fc6e36b1ba22" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
